# كلمة سر الموقع (حساب البيت)
APP_PASSWORD=change-me
# مفتاح توقيع الكوكيز (أي نص عشوائي طويل)
SESSION_SECRET=change-me-long-random-string

# بوت التليجرام (من BotFather) — لا يُرفع على GitHub أبدًا
TELEGRAM_BOT_TOKEN=

# توليد الوجبات بالذكاء الاصطناعي (اختياري — بدونه بيشتغل من مكتبة الوصفات)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# إشعارات الويب (PWA) — اختياري. ولّدها بـ: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@walidmohamed.com

# مكان قاعدة البيانات
DATA_DIR=./data
PORT=3000
TZ=Asia/Kuwait
